<DATAFILE>

[FILEINFO]
file={path='dataHCG.csv'}
delimiter = comma
header={id, y, group, ytype, age, time}

[CONTENT]
id = {use=identifier}
y = {use=observation, yname={'1', '2'}, type={continuous, discrete}}
group = {use=covariate, type=categorical}
ytype = {use=observationtype}
age = {use=regressor}
time = {use=time}

<MODEL>

[COVARIATE]
input = group

group = {type=categorical, categories={'0', '1'}}

[INDIVIDUAL]
input = {a_pop, omega_a, alpha_pop, b_pop, beta_pop, omega_b, gamma_pop, delta_pop, corr_b_a}

DEFINITION:
a = {distribution=normal, typical=a_pop, sd=omega_a}
alpha = {distribution=normal, typical=alpha_pop, no-variability}
b = {distribution=normal, typical=b_pop, sd=omega_b}
beta = {distribution=normal, typical=beta_pop, no-variability}
gamma = {distribution=normal, typical=gamma_pop, no-variability}
delta = {distribution=normal, typical=delta_pop, no-variability}
correlation = {level=id, r(b, a)=corr_b_a}

[LONGITUDINAL]
input = {a_, b_}

file = 'modelo-lineal.txt'

DEFINITION:
y1 = {distribution=normal, prediction=E, errorModel=combined2(a_, b_)}

<FIT>
data = {'2', '1'}
model = {Level, y1}

<PARAMETER>
a_ = {value=1, method=MLE}
a_pop = {value=2.5, method=MLE}
alpha_pop = {value=-2, method=MLE}
b_ = {value=0.3, method=MLE}
b_pop = {value=-0.22, method=MLE}
beta_pop = {value=0.9, method=MLE}
c_ = {value=1, method=FIXED}
corr_b_a = {value=0, method=MLE}
delta_pop = {value=0.01, method=MLE}
gamma_pop = {value=0.5, method=MLE}
omega_a = {value=1, method=MLE}
omega_b = {value=1, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, npc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, predictiondistribution = {selected = true}, likelihoodcontribution = {selected = true}, saemresults = {selected = true}, condmeanresults = {selected = true}, fisher = {selected = true}, likelihoodresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = 'Modelo-lineal-errorCombined2'
nbchains = 5
autochains = no

POPULATION:
burniniterations = 3
smoothingiterations = 500
exploratoryiterations = 1000
simulatedannealingiterations = 1000
exploratoryinterval = 300

